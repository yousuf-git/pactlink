# ── Core ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/pactlink

# ── Auth ──────────────────────────────────────────────────────────
# Must be at least 32 chars.
JWT_SECRET=change-me-to-a-long-random-secret-string-32+
JWT_EXPIRES_IN=1h

# ── CORS / URLs ───────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
ALLOWED_ORIGINS=http://localhost:5173
# Public base URL the client approval links point to (web app).
PUBLIC_APP_URL=http://localhost:5173

# ── Stripe (optional — features disable when unset) ───────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── E-signature provider (optional) ───────────────────────────────
DOCUSEAL_URL=
DOCUSEAL_TOKEN=
DOCUSEAL_WEBHOOK_SECRET=

# ── Object storage (optional) ─────────────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email (optional) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PactLink <no-reply@pactlink.app>"

# ── Seed ──────────────────────────────────────────────────────────
SEED_DEMO_PASSWORD=demo1234
